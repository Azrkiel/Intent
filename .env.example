# Demo is explicit: no network calls, no fabricated model-performance claims.
PROMPT_CALLER_MODE=demo
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Off until smoke-tested on your Token Factory account.
SEND_THINKING_CONTROLS=false
REASONING_BUDGET=2048
SESSION_BUDGET_USD=2.00
DATABASE_PATH=.data/prompt-caller.sqlite3
BUILD_ROOT=.data/builds
# The CLI must already be installed and authenticated. No permission bypass flags.
CLAUDE_COMMAND=claude
CLAUDE_MAX_BUDGET_USD=2.00
BUILD_TIMEOUT_SECONDS=300
# Set true only when ready to run Claude Code on this machine.
ALLOW_CLAUDE_BUILD=false
# Phase 2 backend API only. Requires live approved requirements/plan and an already
# signed-in, policy-compatible Codex profile. Never enables execution for demo plans.
ALLOW_CODEX_EXECUTION=false
CODEX_COMMAND=codex
# Optional: an existing Codex-managed profile directory; no credentials are copied.
# CODEX_HOME=C:/path/to/a/separately-qualified/profile
CODEX_PROJECT_ROOT=.data/projects
CODEX_WORKTREE_ROOT=.data/worktrees
CODEX_TIMEOUT_SECONDS=300
CODEX_APPROVAL_TIMEOUT_SECONDS=120
