{
  "name": "prompt-caller",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "uv run uvicorn backend.app.main:app --host 127.0.0.1 --port 8000",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:api": "uv run pytest -q",
    "eval:demo": "uv run python -m backend.evals.run --demo"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
